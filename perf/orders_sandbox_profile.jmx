<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOAD-PROFILE test of the LOCAL order-events sandbox, Apache JMeter 5.6.3 (Unit 4, Day 16, part B6).
  Written to the performance test plan perf/performance-test-plan.md (ISTQB CT-PT chapter 4):

    setUp     "Prepare"   validate the environment (stop if unhealthy), seed orders for J2 (test data)
    main      open model  ramp-up -> steady state -> ramp-down of journey ARRIVALS (perf/workload.toml)
                          operational mix: J1 (order_pct %) place an order and track it until shipped
                                           J2 (the rest)   check the status of an existing order
                          nested transactions: J1 = J1.1 Submit order + J1.2 Wait until shipped
    listener  abort       stop the LOAD early if the error rate passes abort_error_pct (protect the system)
    tearDown  "Verify"    no dead letters left behind; record whether the run was aborted

  Run (non-GUI; the numbers come from: python -m framework.perf.model perf/workload.toml):
    jmeter -n -t perf/orders_sandbox_profile.jmx -q perf/jmeter.properties -l reports/perf/profile.jtl \
           -Jrate=4 -Jrampup=20 -Jsteady=60 -Jrampdown=20 -Jorder_pct=30
  Properties: host, port, rate, rampup, steady, rampdown, order_pct, seed_orders, max_seed_polls, poll_ms, max_polls,
              think_min_ms, think_range_ms, abort_error_pct, abort_min_samples, run
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Order events sandbox - load profile (open model)">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults - sandbox">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,8765)}</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager - JSON">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Abort criteria: error rate">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// Real-time monitoring with a stop rule (CT-PT 4.3.1): once enough samples exist, an error rate
// above abort_error_pct stops the LOAD. Carrying on would only overload the system and produce
// numbers nobody can use. The tearDown group records the reason as a failed sample.
import java.util.concurrent.atomic.AtomicLong
if (props.get('abort.reason') != null) { return }
// Count only real requests of the load itself: not the preparation/verification groups, and not
// the transaction samples (they repeat their children's failures).
if (!sampleResult.getThreadName().startsWith('Shoppers')) { return }
if ((sampleResult.getResponseMessage() ?: '').startsWith('Number of samples in transaction')) { return }
def total = props.computeIfAbsent('abort.total') { new AtomicLong() } as AtomicLong
def failed = props.computeIfAbsent('abort.failed') { new AtomicLong() } as AtomicLong
long t = total.incrementAndGet()
long f = sampleResult.isSuccessful() ? failed.get() : failed.incrementAndGet()
long minSamples = (props.getProperty('abort_min_samples', '50') as String).toLong()
double limit = (props.getProperty('abort_error_pct', '10') as String).toDouble()
double pct = 100.0d * f / t
if (t &gt;= minSamples &amp;&amp; pct &gt; limit &amp;&amp; props.putIfAbsent('abort.reason',
        String.format('error rate %.1f%% &gt; %.1f%% after %d samples', pct, limit, t)) == null) {
    // No engine stop here: JMeter 5.6.3 cannot stop an open-model thread group from a listener
    // (a graceful stop hangs, an immediate one kills the JVM before tearDown). The gate below
    // sheds the load instead: every later arrival sends nothing.
    log.error('ABORT: ' + props.get('abort.reason') + ' - no more requests will be sent')
}</stringProp>
      </JSR223Listener>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Prepare: validate the environment, seed test data">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="prepare: GET /health">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/health</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="status is ok">
            <stringProp name="JSON_PATH">$.status</stringProp>
            <stringProp name="EXPECTED_VALUE">ok</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="seed orders for J2">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">${__P(seed_orders,20)}</stringProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="prepare: POST /orders (seed)">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{"correlation_id": "PERF-${__P(run,local)}-seed-${__UUID()}", "idempotency_key": "${__UUID()}", "items": [{"sku": "SL-ONESIE", "quantity": 1, "unit_price": "7.99"}]}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/orders</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="202 Accepted">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49588">202</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">seed order not accepted</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="seed_id">
              <stringProp name="JSONPostProcessor.referenceNames">seed_id</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.order_id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="remember the seeded id (shared by all threads)">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def ids = props.computeIfAbsent('seeded_ids') { java.util.Collections.synchronizedList([]) }
if (vars.get('seed_id') != 'NOT_FOUND') { ids.add(vars.get('seed_id')) }</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="wait_for_last_seed">
          <stringProp name="WhileController.condition">${__jexl3("${seed_status}" != "shipped" &amp;&amp; ${__jm__wait_for_last_seed__idx} &lt; ${__P(max_seed_polls,100)})}</stringProp>
        </WhileController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="prepare: GET /orders/{seed} (poll)">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">/orders/${seed_id}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval">
              <stringProp name="ConstantTimer.delay">${__P(poll_ms,100)}</stringProp>
            </ConstantTimer>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200, or 404 while not projected yet">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="0">200|404</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">unexpected status while polling</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">true</boolProp>
              <intProp name="Assertion.test_type">1</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="seed_status">
              <stringProp name="JSONPostProcessor.referenceNames">seed_status</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.status</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">none</stringProp>
            </JSONPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="prepare: test data ready">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def ids = props.get('seeded_ids') ?: []
def wanted = (props.getProperty('seed_orders', '20') as String).toInteger()
def ok = ids.size() == wanted &amp;&amp; vars.get('seed_status') == 'shipped'
SampleResult.setSuccessful(ok)
SampleResult.setResponseCode(ok ? '200' : '500')
SampleResult.setResponseMessage("${ids.size()}/${wanted} orders seeded, last one ${vars.get('seed_status')}")</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="Shoppers (open model)">
        <elementProp name="ThreadGroup.main_controller" elementType="OpenModelThreadGroupController"/>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <stringProp name="OpenModelThreadGroup.schedule">rate(0/s) random_arrivals(${__P(rampup,20)} s) rate(${__P(rate,4)}/s) random_arrivals(${__P(steady,60)} s) rate(${__P(rate,4)}/s) random_arrivals(${__P(rampdown,20)} s) rate(0/s)</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed"></stringProp>
      </OpenModelThreadGroup>
      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Gate: send load only while not aborted">
          <stringProp name="IfController.condition">${__groovy(props.get('abort.reason') == null)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="J1 share (order_pct %)">
            <stringProp name="IfController.condition">${__jexl3(${__Random(1,100,dice)} &lt;= ${__P(order_pct,30)})}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="J1 Place order and track">
              <boolProp name="TransactionController.includeTimers">true</boolProp>
              <boolProp name="TransactionController.parent">false</boolProp>
            </TransactionController>
            <hashTree>
              <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="J1.1 Submit order">
                <boolProp name="TransactionController.includeTimers">false</boolProp>
                <boolProp name="TransactionController.parent">false</boolProp>
              </TransactionController>
              <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /orders">
                  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                    <collectionProp name="Arguments.arguments">
                      <elementProp name="" elementType="HTTPArgument">
                        <boolProp name="HTTPArgument.always_encode">false</boolProp>
                        <stringProp name="Argument.value">{"correlation_id": "PERF-${__P(run,local)}-t${__threadNum}-${__UUID()}", "idempotency_key": "${__UUID()}", "items": [{"sku": "SL-BACKPACK", "quantity": 2, "unit_price": "29.99"}]}</stringProp>
                        <stringProp name="Argument.metadata">=</stringProp>
                      </elementProp>
                    </collectionProp>
                  </elementProp>
                  <stringProp name="HTTPSampler.path">/orders</stringProp>
                  <stringProp name="HTTPSampler.method">POST</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="202 Accepted">
                    <collectionProp name="Asserion.test_strings">
                      <stringProp name="49588">202</stringProp>
                    </collectionProp>
                    <stringProp name="Assertion.custom_message">order not accepted</stringProp>
                    <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                    <boolProp name="Assertion.assume_success">false</boolProp>
                    <intProp name="Assertion.test_type">8</intProp>
                  </ResponseAssertion>
                  <hashTree/>
                  <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="order_id (correlation) and a reset status">
                    <stringProp name="JSONPostProcessor.referenceNames">order_id;status</stringProp>
                    <stringProp name="JSONPostProcessor.jsonPathExprs">$.order_id;$.status</stringProp>
                    <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
                    <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;none</stringProp>
                  </JSONPostProcessor>
                  <hashTree/>
                </hashTree>
              </hashTree>
              <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="J1.2 Wait until shipped">
                <boolProp name="TransactionController.includeTimers">true</boolProp>
                <boolProp name="TransactionController.parent">false</boolProp>
              </TransactionController>
              <hashTree>
                <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="poll_until_shipped">
                  <stringProp name="WhileController.condition">${__jexl3("${status}" != "shipped" &amp;&amp; "${order_id}" != "NOT_FOUND" &amp;&amp; ${__jm__poll_until_shipped__idx} &lt; ${__P(max_polls,100)})}</stringProp>
                </WhileController>
                <hashTree>
                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /orders/{id} (poll)">
                    <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                      <collectionProp name="Arguments.arguments"/>
                    </elementProp>
                    <stringProp name="HTTPSampler.path">/orders/${order_id}</stringProp>
                    <stringProp name="HTTPSampler.method">GET</stringProp>
                    <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                    <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  </HTTPSamplerProxy>
                  <hashTree>
                    <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval">
                      <stringProp name="ConstantTimer.delay">${__P(poll_ms,100)}</stringProp>
                    </ConstantTimer>
                    <hashTree/>
                    <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200, or 404 while not projected yet">
                      <collectionProp name="Asserion.test_strings">
                        <stringProp name="0">200|404</stringProp>
                      </collectionProp>
                      <stringProp name="Assertion.custom_message">unexpected status while polling</stringProp>
                      <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                      <boolProp name="Assertion.assume_success">true</boolProp>
                      <intProp name="Assertion.test_type">1</intProp>
                    </ResponseAssertion>
                    <hashTree/>
                    <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="status">
                      <stringProp name="JSONPostProcessor.referenceNames">status</stringProp>
                      <stringProp name="JSONPostProcessor.jsonPathExprs">$.status</stringProp>
                      <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                      <stringProp name="JSONPostProcessor.defaultValues">none</stringProp>
                    </JSONPostProcessor>
                    <hashTree/>
                  </hashTree>
                </hashTree>
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="check: order shipped within the poll budget">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def status = vars.get('status')
  SampleResult.setSuccessful(status == 'shipped')
  SampleResult.setResponseCode(status == 'shipped' ? '200' : '500')
  SampleResult.setResponseMessage("order ${vars.get('order_id')} status=${status}")</stringProp>
                </JSR223Sampler>
                <hashTree/>
              </hashTree>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="J2 share (the rest)">
            <stringProp name="IfController.condition">${__jexl3(${dice} &gt; ${__P(order_pct,30)})}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="J2 Check order status">
              <boolProp name="TransactionController.includeTimers">false</boolProp>
              <boolProp name="TransactionController.parent">false</boolProp>
            </TransactionController>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="parameterise: a random seeded order">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def ids = props.get('seeded_ids') ?: ['NOT_SEEDED']
  vars.put('ref_id', ids[new Random().nextInt(ids.size())] as String)</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time 1-3 s (reads the e-mail, clicks the link)">
                <stringProp name="ConstantTimer.delay">${__P(think_min_ms,1000)}</stringProp>
                <stringProp name="RandomTimer.range">${__P(think_range_ms,2000)}</stringProp>
              </UniformRandomTimer>
              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /orders/{ref}">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
                <stringProp name="HTTPSampler.path">/orders/${ref_id}</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="the order asked for, and shipped">
                  <stringProp name="JSON_PATH">$.status</stringProp>
                  <stringProp name="EXPECTED_VALUE">shipped</stringProp>
                  <boolProp name="JSONVALIDATION">true</boolProp>
                  <boolProp name="EXPECT_NULL">false</boolProp>
                  <boolProp name="INVERT">false</boolProp>
                  <boolProp name="ISREGEX">false</boolProp>
                </JSONPathAssertion>
                <hashTree/>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="200 OK">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="49586">200</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.custom_message">order status not available</stringProp>
                  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">8</intProp>
                </ResponseAssertion>
                <hashTree/>
              </hashTree>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Verify: clean end state">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </PostThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="verify: GET /metrics">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/metrics</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="no dead letters left behind">
            <stringProp name="JSON_PATH">$.dead_letters</stringProp>
            <stringProp name="EXPECTED_VALUE">0</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
        </hashTree>
